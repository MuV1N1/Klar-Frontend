# Set to "false" to talk to the real Spring Boot backend instead of the local mock service.
PUBLIC_USE_MOCK_API=true
# Base URL of the REST API (only used when PUBLIC_USE_MOCK_API=false).
# The texts (translations) always come from here, also in mock mode.
PUBLIC_API_BASE_URL=http://localhost:8080/api
# Optional, server-side only: backend URL for loading the texts (Docker: http://app:8080/api).
# API_INTERNAL_URL=
